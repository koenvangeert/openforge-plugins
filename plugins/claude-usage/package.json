{
  "name": "@kvg/openforge-claude-usage",
  "version": "0.1.0",
  "description": "Shows what Claude Code has cost, priced from local transcripts.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "openforge",
    "openforge-plugin",
    "claude-code",
    "usage"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.backend.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/svelte": "^1.25.0",
    "@openforge-app/plugin-sdk": "^0.3.1",
    "chart.js": "^4.5.1"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "^26.0.0",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "openforge": {
    "id": "dev.kvg.claude-usage",
    "apiVersion": 1,
    "displayName": "Claude Usage",
    "description": "Prices local Claude Code transcripts and charts spend by project, task, and model.",
    "icon": "chart-column-big",
    "enablement": "app",
    "frontend": "./dist/frontend.js",
    "frontendStyles": [
      "./dist/openforge-claude-usage.css"
    ],
    "backend": "./dist/backend.js",
    "requires": [
      "views",
      "backend",
      "background",
      "fs",
      "tasks",
      "projects",
      "appEnablement",
      "customSidebarNavigation",
      "taskPane",
      "settings",
      "storage"
    ]
  }
}
