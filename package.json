{
  "name": "openforge-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:sdk": "pnpm -C ../openforge --filter @openforge-app/plugin-sdk build",
    "setup": "pnpm run build:sdk && pnpm install",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@openforge-app/plugin-sdk": "^0.2.9"
  }
}
